# This file contains all the environment variables needed to run the application stack.
# Copy this file to .env and fill in the values before running the application.

# --- MinIO S3 Storage ---
# Used by MinIO, runner_controller, and runner
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_ENDPOINT=minio:9000

# --- CockroachDB Database ---
# Used by auth, runner_controller, and runner
COCKROACHDB_URL=postgresql://root@cockroachdb:26257/defaultdb?sslmode=disable

# --- Redis ---
# Used by runner_controller and runner
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=evoc_tasks

# --- Auth Microservice ---
# Used by the auth service itself
MAILER_EMAIL=
MAILER_PASSWORD=
AUTH_HTTP_PORT=5000
AUTH_GRPC_PORT=5001
# Set to 'true' on the first run to initialize the database schema
INIT_DB_FLAG=true 

# --- Runner Controller Microservice ---
# Used by the runner_controller service
RUNNER_CONTROLLER_HTTP_PORT=5002

# --- Inter-service Communication ---
# URL for the auth service's gRPC endpoint
AUTH_GRPC_ADDRESS=auth:5001

# --- LLM Microservice (evoc-deap-agent) ---
# Used by the llm_service
# Get your key from https://wow.groq.com/
GROQ_API_KEY=
# The model to use, e.g., llama3-70b-8192
MODEL_NAME=llama3-70b-8192
# Optional: API key for Mem0 if you use it
MEM0_API_KEY=
# Port for the LLM service
PORT=8000
LOG_LEVEL=info


# --- Frontend (Evolve UI) ---
# These are the public URLs that the frontend will use to communicate with the backends.
# In a typical deployment, these would point to your public domain or API gateway.
# For local testing, they can point to the Docker host's IP and exposed ports.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:5002
NEXT_PUBLIC_V2_BACKEND_BASE_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:5000
NEXT_PUBLIC_MINIO_BASE_URL=http://localhost:9000

# --- AI & Gemini ---
# Set to true and paste token if you want to use extra AI features.
NEXT_PUBLIC_AI=false
GOOGLE_GENERATIVE_AI_API_KEY=
